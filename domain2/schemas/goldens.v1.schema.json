{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d2:goldens:v1",
  "title": "Goldens",
  "description": "Probe answers every adapter agreed on, as predicted and audited clean, keyed by the snapshot's bytes (S7). A run writes its candidates; `cwabench --domain 2 goldens accept` adopts them.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d2/goldens/v1"
    },
    "from_run": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_commit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "trace_hash": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "snapshot": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "conversation": {
            "type": "string",
            "minLength": 1
          },
          "arm": {
            "type": "string",
            "minLength": 1
          },
          "probe_id": {
            "type": "string",
            "pattern": "^p[0-9]{3}$"
          },
          "tier": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "assembled",
              "refused",
              "rejected",
              "unsupported",
              "crashed",
              "timeout",
              "invalid_output"
            ]
          },
          "refusal_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "payload_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "trace_hash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "snapshot",
          "case_id",
          "conversation",
          "arm",
          "probe_id",
          "tier",
          "outcome",
          "refusal_reason",
          "payload_hash",
          "trace_hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "from_run",
    "created_at",
    "contract_commit",
    "adapters",
    "trace_hash",
    "entries"
  ],
  "additionalProperties": false
}
