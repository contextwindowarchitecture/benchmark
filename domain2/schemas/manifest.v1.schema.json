{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d2:manifest:v1",
  "title": "Run manifest",
  "description": "Everything a run was made from, so it can be reproduced and compared.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d2/manifest/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "error",
        "running"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "python": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "source_digest",
        "python"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "copy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "copy"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pinned": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_draft": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "pinned",
        "commit",
        "dirty",
        "remote",
        "repository",
        "spec_draft"
      ],
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "checkout": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dirty": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "remote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "repository": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "toolchain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "build": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer"
                },
                "seconds": {
                  "type": "number"
                }
              },
              "required": [
                "argv",
                "cwd",
                "exit_code",
                "seconds"
              ],
              "additionalProperties": false
            }
          },
          "timing": {
            "description": "The in-process timing loop S7 uses (method 3), when the adapter configures one",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "command": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "command",
                  "error"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "available",
          "error",
          "language",
          "checkout"
        ],
        "additionalProperties": false
      }
    },
    "host": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "cpus": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "release",
        "machine",
        "cpus",
        "platform"
      ],
      "additionalProperties": false
    },
    "env_cells": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]+$"
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "timeout_s": {
          "type": "number"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "timeout_s",
        "concurrency"
      ],
      "additionalProperties": false
    },
    "container": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_suspended_seconds": {
      "type": "number",
      "minimum": 0
    },
    "ci": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "checkouts",
                "mirrors",
                "provided"
              ]
            },
            "mirrors": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    },
                    "required": [
                      "url",
                      "path",
                      "ref",
                      "commit"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "profile",
            "source",
            "mirrors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Set when the run is one of a CI profile's (cwabench ci): the profile, and where the repositories came from"
    }
  },
  "required": [
    "$schema",
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "command",
    "harness",
    "config",
    "contract",
    "adapters",
    "host",
    "env_cells",
    "seed",
    "suites",
    "settings",
    "container",
    "host_suspended_seconds"
  ],
  "additionalProperties": false
}
