{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d1:determinism-row:v1",
  "title": "Determinism row",
  "description": "One answer in S2 or S10: a snapshot through one adapter in one environment cell and repetition, compared with that snapshot's first host baseline answer. Payload and trace blobs are stored only when they differ from it.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d1/determinism-row/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "suite": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_kind": {
      "enum": [
        "case",
        "rejection"
      ]
    },
    "snapshot": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "env_cell": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "applied": {
      "type": "boolean"
    },
    "not_applied_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "assembled",
        "refused",
        "rejected",
        "unsupported",
        "crashed",
        "timeout",
        "invalid_output"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "refusal_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "matches_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "boolean"
            },
            "payload": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "trace": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "decision",
            "payload",
            "trace"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "wall_ms": {
      "type": "number",
      "minimum": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[1-9][0-9]*$"
      }
    },
    "finding": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "run_id",
    "suite",
    "corpus",
    "case_id",
    "case_kind",
    "snapshot",
    "adapter",
    "env_cell",
    "platform",
    "repetition",
    "applied",
    "not_applied_reason",
    "outcome",
    "exit_code",
    "refusal_reason",
    "payload_hash",
    "trace_hash",
    "matches_reference",
    "payload",
    "trace",
    "stderr",
    "wall_ms",
    "requirements",
    "finding"
  ],
  "additionalProperties": false
}
