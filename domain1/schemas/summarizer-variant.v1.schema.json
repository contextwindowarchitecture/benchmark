{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d1:summarizer-variant:v1",
  "title": "Summarizer variant",
  "description": "S11: one proposed variant of one chunk (an arm and a sample), its fidelity checks, and whether R-18's variant rules kept it.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d1/summarizer-variant/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "arm": {
      "enum": [
        "stub",
        "llm"
      ]
    },
    "sample": {
      "type": "integer",
      "minimum": 0
    },
    "chunk": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "enum": [
        "verbatim",
        "summarised",
        "redacted",
        "translated",
        "extracted",
        "generated"
      ]
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "parent_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "kept": {
      "type": "boolean"
    },
    "dropped": {
      "anyOf": [
        {
          "enum": [
            "empty",
            "not_shorter",
            "duplicate_id",
            "fidelity"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "cache": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hit": {
              "type": "boolean"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lookup_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "hit",
            "key",
            "lookup_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "judge": {
      "anyOf": [
        {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "UNCLEAR"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "run_id",
    "arm",
    "sample",
    "chunk",
    "variant_id",
    "method",
    "lineage",
    "tokens",
    "parent_tokens",
    "kept",
    "dropped",
    "failed_checks",
    "checks",
    "cache",
    "judge",
    "body"
  ],
  "additionalProperties": false
}
