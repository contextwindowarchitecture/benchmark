{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d1:runs-index:v1",
  "title": "Runs index",
  "description": "Every run under the results directory, newest first.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d1/runs-index/v1"
    },
    "latest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
          },
          "status": {
            "enum": [
              "pass",
              "partial",
              "fail",
              "error",
              "running"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "suites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            }
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ci_profile": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "started_at",
          "finished_at",
          "path",
          "suites",
          "adapters"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "latest",
    "runs"
  ],
  "additionalProperties": false
}
