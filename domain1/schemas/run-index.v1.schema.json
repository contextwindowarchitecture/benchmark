{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d1:run-index:v1",
  "title": "Run index",
  "description": "The entry point of one run directory: every file in it and its schema.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d1/run-index/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "error",
        "running"
      ]
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]+$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "kind",
          "schema",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "blobs": {
      "type": "object",
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "layout",
        "count"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "description": "Present when this directory is a fixture written by `cwabench fixture`: the run it was cut from and how much was kept.",
      "type": "object",
      "properties": {
        "of": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "sweeps": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "of",
        "created_at",
        "rows",
        "frames",
        "sweeps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "run_id",
    "status",
    "suites",
    "files",
    "blobs"
  ],
  "additionalProperties": false
}
