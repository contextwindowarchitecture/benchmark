              {
                "type": "object",
                "properties": {
                  "rejected": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "rejected",
                  "failed",
                  "skipped",
                  "total"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "outcomes": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "assembled",
                "refused",
                "rejected",
                "unsupported",
                "crashed",
                "timeout",
                "invalid_output"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
