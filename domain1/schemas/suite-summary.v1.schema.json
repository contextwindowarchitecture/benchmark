    "$schema": {
      "const": "cwa-bench-d1/suite-summary/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "suite": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "error"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[1-9][0-9]*$"
      }
    },
    "corpora": {
