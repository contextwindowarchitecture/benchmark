# Generated by cwabench setup from adapters/timing/rust/Cargo.toml.in: the in-process timing loop, built against the
# assembler checkout as a path dependency so the checkout is not modified.
[package]
name = "cwabench-timing"
version = "0.0.0"
edition = "2021"
publish = false

[[bin]]
name = "cwabench-timing"
path = "{root}/adapters/timing/rust/src/main.rs"

[dependencies]
contextwindowarchitecture-assembler = { path = "{checkout}" }

[workspace]
