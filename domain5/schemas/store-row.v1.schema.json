{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d5:store-row:v1",
  "title": "Store row",
  "description": "One output of an S6 model-written producer (domain-5-plan.md, 6.5): a memory note, the extracted state after a turn, or a rolling summary, and whether it held the attack.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d5/store-row/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "suite": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "chain": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "attack": {
      "enum": [
        "none",
        "persist",
        "value",
        "trigger"
      ]
    },
    "turn": {
      "type": "integer",
      "minimum": 1
    },
    "store": {
      "enum": [
        "note",
        "state",
        "summary"
      ]
    },
    "text": {
      "type": "string"
    },
    "carries": {
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "run_id",
    "suite",
    "case_id",
    "chain",
    "arm",
    "attack",
    "turn",
    "store",
    "text",
    "carries"
  ],
  "additionalProperties": false
}
