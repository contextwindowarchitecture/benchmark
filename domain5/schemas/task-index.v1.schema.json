{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d5:task-index:v1",
  "title": "Task index",
  "description": "The task instances one family generated for a run (tasks/<family>/index.json); each instance is a blob.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d5/task-index/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}(-[0-9]+)?$"
    },
    "family": {
      "enum": [
        "em",
        "dq",
        "tq",
        "dg",
        "cq",
        "sl"
      ]
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer"
    },
    "size": {
      "enum": [
        "pilot",
        "recorded"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z]{2}-[pi][0-9]{2,}(-l[0-9]{2}k)?$"
          },
          "variant": {
            "enum": [
              "plain",
              "imperative"
            ]
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "contract": {
            "enum": [
              "plain",
              "action",
              "record",
              "code"
            ]
          },
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "words": {
            "type": "integer",
            "minimum": 0
          },
          "task": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "task_id",
          "variant",
          "seed",
          "contract",
          "items",
          "words",
          "task"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "run_id",
    "family",
    "generator",
    "seed",
    "size",
    "parameters",
    "tasks"
  ],
  "additionalProperties": false
}
