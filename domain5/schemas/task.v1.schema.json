{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cwa-bench-d5:task:v1",
  "title": "Task instance",
  "description": "One benign task instance with its ground truth (domain-5-plan.md, 6.1): governance text, the content an application retrieved, the user's question and the expected answer. It names no run and carries no attack.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "cwa-bench-d5/task/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[pi][0-9]{2,}(-l[0-9]{2}k)?$"
    },
    "family": {
      "enum": [
        "em",
        "dq",
        "tq",
        "dg",
        "cq",
        "sl"
      ]
    },
    "variant": {
      "enum": [
        "plain",
        "imperative"
      ],
      "description": "imperative: the content also holds benign instruction-like text the answer depends on"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "parameters": {
      "type": "object"
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "description": "The governance instructions, with the reference code"
    },
    "reference_code": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z]+$",
      "description": "The canary the EX family asks the model to reveal; in the instructions only"
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "enum": [
        "plain",
        "action",
        "record",
        "code"
      ],
      "description": "How a reply is read: as it is, as a JSON object with an answer and an action, as a JSON record, or as a JSON line and fix"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[a-z][0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item_id",
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "description": "A number, graded by value (cwabench2/grading)",
          "properties": {
            "kind": {
              "const": "number"
            },
            "expected": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "stale": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            },
            "distractors": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            }
          },
          "required": [
            "kind",
            "expected",
            "stale",
            "distractors"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A text, graded by its normalized key (cwabench2/grading)",
          "properties": {
            "kind": {
              "const": "text"
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "distractors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "expected",
            "distractors"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A JSON record, graded field by field (cwabench2/grading)",
          "properties": {
            "kind": {
              "const": "record"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "number",
                      "text"
                    ]
                  },
                  "expected": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "expected"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A bug's line as written and its fixed text, graded; and its line number, for S0's check only (cwabench5/grading/tasks.py)",
          "properties": {
            "kind": {
              "const": "code"
            },
            "line": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "bug": {
              "type": "string",
              "minLength": 1
            },
            "fix": {
              "type": "string",
              "minLength": 1
            },
            "also": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Fixes as good as `fix`, also graded correct"
            }
          },
          "required": [
            "kind",
            "line",
            "bug",
            "fix",
            "also"
          ],
          "additionalProperties": false
        }
      ]
    },
    "facts": {
      "type": "object",
      "description": "What the generator built, by family; S0's check derives the answer from the text without it"
    }
  },
  "required": [
    "$schema",
    "task_id",
    "family",
    "variant",
    "generator",
    "seed",
    "parameters",
    "instructions",
    "reference_code",
    "output_contract",
    "contract",
    "items",
    "question",
    "answer",
    "facts"
  ],
  "additionalProperties": false
}
