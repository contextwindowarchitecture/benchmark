  "text": "Winter\n\n```php\nfunction getMaxOccurrence(array $numbers) {\n    if (empty($numbers)) {\n        return null;\n    }\n\n    $counts = array_count_values($numbers);\n    \n    $maxCount = max($counts);\n    \n    $candidates = array_keys(array_filter($counts, function($count) use ($maxCount) {\n        return $count === $maxCount;\n    }));\n    \n    return min($candidates);\n}\n```"
